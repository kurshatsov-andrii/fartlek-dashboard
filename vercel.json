{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://fartlek-dashboard.vercel.app"
  },
  "framework": "nextjs",
  "regions": ["fra1"],
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "github": {
    "silent": false,
    "autoJobCancelation": true
  },
  "crons": [
    {
      "path": "/api/cron/sync-telegram",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/refresh-post-images",
      "schedule": "30 6 * * *"
    }
  ]
}
