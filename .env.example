# Публічний URL сайту без слешу в кінці. Має збігатися з тим, що в адресному рядку / у Vercel Environment Variables.
# — magic link Supabase, канонічні URL, посилання в асистенті.
# Приклад деплою: https://fartlek-dashboard.vercel.app
# Приклад власного домену: https://fartlek.events
# Локально можна не задавати (асистент і посилання візьмуть origin з браузера).
NEXT_PUBLIC_SITE_URL=https://fartlek-dashboard.vercel.app

# Supabase — публічний URL і ключ для magic link у браузері
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJ...

# Серверний service role — лише на сервері (синк у БД, скрипти)
SUPABASE_SERVICE_ROLE_KEY=

# Через кому або «;»: email саме адмін-панелі (мають збігатися з обліковим записом у Supabase Auth)
ADMIN_EMAIL_ALLOWLIST=you@domain.com,colleague@domain.com

# Опціонально: POST /api/sync-telegram із Authorization: Bearer (cron, CI без браузера)
TELEGRAM_SYNC_SECRET=

# Cron (Vercel): Bearer для GET /api/cron/sync-telegram та /api/cron/refresh-post-images
# Згенерувати: openssl rand -hex 32
# CRON_SECRET=
# Ручний запуск refresh (не з адресного рядка браузера — там немає Bearer):
# curl -H "Authorization: Bearer $CRON_SECRET" "https://YOUR_DOMAIN/api/cron/refresh-post-images"
# Вимкнути щоденне оновлення превʼю через cron без зміни vercel.json:
# CRON_REFRESH_POST_IMAGES_DISABLED=1

# Опціонально: зовнішня кнопка Wayforpay для оплати розміщення старту в Telegram (за замовчуванням уже задана)
# NEXT_PUBLIC_WAYFORPAY_PUBLISH_URL=https://secure.wayforpay.com/button/b8d2696506552

# OpenAI — серверний ключ для LangChain-чату /assistant (не публікуйте в клієнт)
OPENAI_API_KEY=
# Опціонально: модель (за замовчуванням gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# --- Docker Compose (nginx/ssl + postgres у docker-compose.yml) ---
# Публічний HTTPS-URL із адресного рядка браузера (локально часто https://localhost)
# NEXT_PUBLIC_SITE_URL=https://localhost
#
# Postgres у compose — для сервісу backend або власної схеми; Next за замовчуванням ходить у Supabase Cloud.
# DATABASE_URL можна не задавати, якщо збігаються типові логін/пароль/БД із POSTGRES_*.
# POSTGRES_USER=fartlek
# POSTGRES_PASSWORD=fartlek
# POSTGRES_DB=fartlek
# DATABASE_URL=postgres://USER:PASSWORD@postgres:5432/DBNAME
